<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
<script>
const $=id=>document.getElementById(id);
const state={db:null,stream:null,models:false,staff:[],attendance:[],matched:null,descriptor:null,role:null,user:null};
const today=()=>new Date().toLocaleDateString('sv-SE');
const nowTime=()=>new Date().toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',hour12:false});
$('todayLabel').textContent=new Date().toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
$('reportFrom').value=today();$('reportTo').value=today();
function toast(s){$('toast').textContent=s;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',4500)}
function showPage(p){document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===p));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===p));$('pageTitle').textContent=({dashboard:'Dashboard',absensi:'Absensi Face ID',pegawai:'Data Pegawai',laporan:'Laporan Kehadiran',pengaturan:'Pengaturan'})[p];if(p==='pegawai')renderStaff();if(p==='laporan')renderReport()}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function getSettings(){try{return JSON.parse(localStorage.getItem('sarmiSettings')||'{}')}catch{return {}}}
function setConn(s,ok=false){$('connection').textContent=s;$('connection').style.background=ok?'#e4f7ed':'#fff0dc';$('connection').style.color=ok?'#18754f':'#925b00'}
function showAuth(message){$('authGate').style.display='flex';if(message)$('authStatus').textContent=message;$('logoutButton').style.display='none'}
function hideAuth(){ $('authGate').style.display='none'; $('logoutButton').style.display='inline-block'; }
function setAuthMessage(message){$('authStatus').textContent=message}
async function activateSession(){
 if(!state.db)throw Error('Hubungkan database terlebih dahulu.');
 const {data:{session},error:sessionError}=await state.db.auth.getSession();
 if(sessionError)throw sessionError;
 if(!session){state.role=null;state.user=null;$('loginButton').disabled=true;setConn('Login diperlukan');showAuth('Database terhubung. Silakan login dengan akun admin/operator.');return false;}
 const {data:role,error:roleError}=await state.db.rpc('get_my_role');
 if(roleError)throw Error('Gagal memeriksa peran akun. Jalankan SQL keamanan dan tetapkan peran admin/operator. Detail: '+roleError.message);
 if(!['admin','operator'].includes(role)){await state.db.auth.signOut();state.role=null;state.user=null;throw Error('Akun ini belum diberi peran admin/operator. Minta administrator menetapkan peran melalui SQL Supabase.');}
 state.role=role;state.user=session.user;await refreshData();
 $('staffForm').querySelectorAll('input,select,button').forEach(el=>el.disabled=role!=='admin');
 $('enrollFace').disabled=role!=='admin'||!state.stream||!state.models;
 setConn('Login: '+role,true);hideAuth();toast('Login berhasil sebagai '+role+'.');return true;
}
async function connect(url,key){if(!window.supabase)throw Error('SDK Supabase tidak berhasil dimuat. Periksa internet/CDN.');if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url))throw Error('Project URL tidak sesuai format https://PROJECT.supabase.co');state.db=window.supabase.createClient(url,key);$('loginButton').disabled=false;const {data:{session},error}=await state.db.auth.getSession();if(error)throw error;if(session){await activateSession()}else{state.role=null;state.user=null;setConn('Login diperlukan');showAuth('Koneksi Supabase berhasil. Login diperlukan untuk mengakses data.');} }
$('authConfigForm').addEventListener('submit',async e=>{e.preventDefault();const url=$('authSupabaseUrl').value.trim(),key=$('authSupabaseKey').value.trim();try{localStorage.setItem('sarmiSettings',JSON.stringify({url,key,late:'07:30'}));$('supabaseUrl').value=url;$('supabaseKey').value=key;await connect(url,key);setAuthMessage('Koneksi berhasil. Silakan login.');toast('Konfigurasi Supabase disimpan di browser ini.')}catch(err){state.db=null;$('loginButton').disabled=true;setConn('Koneksi gagal');setAuthMessage('Koneksi gagal: '+err.message);}}
);
$('authLoginForm').addEventListener('submit',async e=>{e.preventDefault();if(!state.db)return setAuthMessage('Hubungkan Supabase terlebih dahulu.');$('loginButton').disabled=true;try{const {error}=await state.db.auth.signInWithPassword({email:$('authEmail').value.trim(),password:$('authPassword').value});if(error)throw error;await activateSession();$('authPassword').value='';}catch(err){if(state.db)await state.db.auth.signOut().catch(()=>{});state.role=null;state.user=null;showAuth('Login gagal: '+err.message);setConn('Login gagal');}finally{$('loginButton').disabled=!state.db;}});
$('logoutButton').onclick=async()=>{try{if(state.db)await state.db.auth.signOut();state.role=null;state.user=null;state.staff=[];state.attendance=[];setConn('Login diperlukan');showAuth('Anda sudah keluar. Login kembali untuk melanjutkan.')}catch(e){toast('Gagal keluar: '+e.message)}};
$('settingsForm').addEventListener('submit',async e=>{e.preventDefault();let url=$('supabaseUrl').value.trim(),key=$('supabaseKey').value.trim();try{localStorage.setItem('sarmiSettings',JSON.stringify({url,key,late:$('lateTime').value||'07:30'}));await connect(url,key)}catch(err){state.db=null;setConn('Koneksi gagal');showAuth('Koneksi gagal: '+err.message);toast('Koneksi gagal: '+err.message)}});
$('disconnect').onclick=async()=>{if(state.db)await state.db.auth.signOut().catch(()=>{});state.db=null;state.role=null;state.user=null;localStorage.removeItem('sarmiSettings');setConn('Terputus');showAuth('Koneksi diputus. Masukkan konfigurasi Supabase untuk menghubungkan kembali.');$('loginButton').disabled=true;toast('Kredensial lokal dihapus dari browser ini.')};
async function refreshData(){if(!state.db||!state.role)return;const [s,a]=await Promise.all([state.db.from('employees').select('*').order('name'),state.db.from('attendance').select('*').gte('work_date',today()).lte('work_date',today()).order('created_at',{ascending:false})]);if(s.error)throw s.error;if(a.error)throw a.error;state.staff=s.data||[];state.attendance=a.data||[];renderStaff();renderDashboard();renderReport()}
function renderDashboard(){const active=state.staff.filter(x=>x.active);$('statStaff').textContent=active.length;const ids=new Set(state.attendance.filter(x=>x.check_in).map(x=>x.employee_id));$('statPresent').textContent=ids.size;const late=state.attendance.filter(x=>x.status==='Terlambat').length;$('statLate').textContent=late;$('statAbsent').textContent=Math.max(0,active.length-ids.size);const map=new Map(state.staff.map(x=>[x.id,x]));$('dashRows').innerHTML=state.attendance.length?state.attendance.map(a=>{const p=map.get(a.employee_id)||{};return `<tr><td>${esc(p.name||a.employee_id)}</td><td>${esc(p.employee_type||'-')}</td><td>${esc(a.check_in||'-')}</td><td>${esc(a.check_out||'-')}</td><td><span class="status ${a.status==='Terlambat'?'late':''}">${esc(a.status||'Hadir')}</span></td></tr>`}).join(''):'<tr><td colspan="5" class="empty">Belum ada absensi hari ini.</td></tr>'}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderStaff(){const list=state.staff;$('staffRows').innerHTML=list.length?list.map(p=>`<tr><td>${esc(p.id)}</td><td>${esc(p.name)}</td><td>${esc(p.employee_type)}</td><td>${esc(p.role||'-')}</td><td>${p.face_descriptor?'Terdaftar':'Belum'}</td><td>${p.active?'Aktif':'Nonaktif'}</td><td>${state.role==='admin'?`<button class="danger" style="padding:6px 8px;font-size:10px" onclick="deleteStaff('${encodeURIComponent(p.id)}')">Hapus</button>`:'-'}</td></tr>`).join(''):'<tr><td colspan="7" class="empty">Belum ada data pegawai.</td></tr>';$('enrollStaff').innerHTML='<option value="">Pilih pegawai</option>'+list.filter(p=>p.active&&p.consent).map(p=>`<option value="${esc(p.id)}">${esc(p.name)} — ${esc(p.id)}</option>`).join('')}
window.deleteStaff=async id=>{if(!state.db)return toast('Database belum terhubung.');id=decodeURIComponent(id);if(!confirm('Hapus pegawai dan riwayat absensinya sesuai kebijakan sekolah?'))return;const r=await state.db.from('employees').delete().eq('id',id);if(r.error)return toast(r.error.message);await refreshData();toast('Pegawai dihapus jika diizinkan kebijakan database.')};
$('staffForm').addEventListener('submit',async e=>{e.preventDefault();if(!state.db)return toast('Hubungkan database di Pengaturan.');const id=$('staffId').value.trim(),name=$('staffName').value.trim();const row={id,name,employee_type:$('staffType').value,role:$('staffRole').value.trim(),active:$('staffActive').value==='true',consent:$('staffConsent').value==='true'};if(!row.consent)return toast('Konfirmasi persetujuan pemrosesan biometrik terlebih dahulu.');const {error}=await state.db.from('employees').upsert(row,{onConflict:'id'});if(error)return toast('Gagal menyimpan: '+error.message);$('staffForm').reset();await refreshData();toast('Data pegawai tersimpan.');});
async function loadModels(){try{$('modelStatus').textContent='Status model: sedang dimuat…';await Promise.all([faceapi.nets.tinyFaceDetector.loadFromUri('https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights'),faceapi.nets.faceLandmark68Net.loadFromUri('https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights'),faceapi.nets.faceRecognitionNet.loadFromUri('https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights')]);state.models=true;$('modelStatus').textContent='Status model: siap.';$('scanFace').disabled=!state.stream;$('enrollFace').disabled=!state.stream;toast('Model wajah siap digunakan.')}catch(e){$('modelStatus').textContent='Gagal memuat model: '+e.message;toast('Model gagal dimuat. Periksa koneksi dan sumber model.')}}
$('loadModels').onclick=loadModels;
$('startCamera').onclick=async()=>{try{state.stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'},audio:false});$('video').srcObject=state.stream;$('cammsg').style.display='none';$('startCamera').disabled=true;$('stopCamera').disabled=false;$('cameraStatus').textContent='Kamera aktif. Pastikan pengguna mengetahui kamera sedang digunakan.';$('scanFace').disabled=!state.models;$('enrollFace').disabled=!state.models;toast('Kamera aktif.')}catch(e){toast('Tidak dapat mengakses kamera: '+e.message+' Pastikan HTTPS dan izin kamera diaktifkan.')}};
$('stopCamera').onclick=()=>{if(state.stream)state.stream.getTracks().forEach(t=>t.stop());state.stream=null;$('video').srcObject=null;$('cammsg').style.display='flex';$('cammsg').innerHTML='Kamera dimatikan.<br>Aktifkan kembali untuk melanjutkan.';$('startCamera').disabled=false;$('stopCamera').disabled=true;$('scanFace').disabled=true;$('enrollFace').disabled=true;$('saveAttendance').disabled=true};
async function getDescriptor(){if(!state.models||!state.stream)throw Error('Muat model dan aktifkan kamera terlebih dahulu.');const det=await faceapi.detectSingleFace($('video'),new faceapi.TinyFaceDetectorOptions({inputSize:320,scoreThreshold:.55})).withFaceLandmarks().withFaceDescriptor();if(!det)throw Error('Wajah belum terdeteksi. Hadapkan wajah ke kamera dan coba lagi.');return Array.from(det.descriptor)}
$('scanFace').onclick=async()=>{try{$('scanFace').disabled=true;$('cameraStatus').textContent='Menganalisis wajah…';const desc=await getDescriptor();state.descriptor=desc;const candidates=state.staff.filter(p=>p.active&&p.consent&&Array.isArray(p.face_descriptor));if(!candidates.length)throw Error('Belum ada template wajah pegawai yang terdaftar.');let best=null,dist=Infinity;for(const p of candidates){const d=faceapi.euclideanDistance(new Float32Array(desc),new Float32Array(p.face_descriptor));if(d<dist){dist=d;best=p}}if(!best||dist>.48){state.matched=null;$('matchResult').innerHTML='<b>Wajah belum cocok</b><p class="sub" style="margin:7px 0 0">Tidak ada kecocokan yang cukup. Silakan coba lagi atau gunakan prosedur absensi alternatif.</p>';$('saveAttendance').disabled=true;toast('Verifikasi tidak berhasil.')}else{state.matched=best;$('matchResult').innerHTML=`<b style="color:#16744e">✓ Wajah dikenali</b><h2 style="margin:12px 0 5px">${esc(best.name)}</h2><p class="sub" style="margin:0">${esc(best.id)} · ${esc(best.employee_type)} · jarak ${dist.toFixed(3)}</p>`;$('saveAttendance').disabled=false;$('cameraStatus').textContent='Verifikasi berhasil. Pastikan identitas yang tampil benar.';toast('Wajah dikenali. Periksa identitas sebelum menyimpan.')}}catch(e){toast(e.message)}finally{$('scanFace').disabled=!state.stream||!state.models}};
$('enrollFace').onclick=async()=>{try{if(!state.db)throw Error('Hubungkan database terlebih dahulu.');const id=$('enrollStaff').value;if(!id)throw Error('Pilih pegawai.');const p=state.staff.find(x=>x.id===id);if(!p||!p.consent)throw Error('Pegawai belum memberi persetujuan.');const samples=[];for(let i=0;i<3;i++){toast(`Sampel ${i+1}/3: posisikan wajah dengan jelas.`);samples.push(await getDescriptor());await new Promise(r=>setTimeout(r,700))}const avg=samples[0].map((_,j)=>samples.reduce((sum,s)=>sum+s[j],0)/samples.length);const {error}=await state.db.from('employees').update({face_descriptor:avg}).eq('id',id);if(error)throw error;await refreshData();toast('Template wajah tersimpan. Foto mentah tidak disimpan oleh aplikasi.')}catch(e){toast('Pendaftaran wajah gagal: '+e.message)}};
$('saveAttendance').onclick=async()=>{try{if(!state.db)throw Error('Database belum terhubung.');if(!state.matched)throw Error('Verifikasi wajah belum berhasil.');const p=state.matched,kind=$('attendanceType').value,dt=nowTime(),date=today();const {data:existing,error:findErr}=await state.db.from('attendance').select('*').eq('employee_id',p.id).eq('work_date',date).maybeSingle();if(findErr)throw findErr;const late=getSettings().late||'07:30';let payload;if(kind==='masuk'){if(existing?.check_in)throw Error('Absensi masuk sudah tercatat hari ini.');payload={employee_id:p.id,work_date:date,check_in:dt,status:dt>late?'Terlambat':'Hadir',note:$('attendanceNote').value.trim()}}else{if(!existing?.check_in)throw Error('Absen masuk belum tercatat.');if(existing.check_out)throw Error('Absensi pulang sudah tercatat hari ini.');payload={check_out:dt,note:$('attendanceNote').value.trim()}}let q=kind==='masuk'?state.db.from('attendance').insert(payload):state.db.from('attendance').update(payload).eq('id',existing.id);const {error}=await q;if(error)throw error;state.matched=null;$('saveAttendance').disabled=true;$('matchResult').innerHTML='<b>Absensi tersimpan</b><p class="sub" style="margin:7px 0 0">Kehadiran berhasil dicatat di database.</p>';await refreshData();toast('Absensi '+kind+' berhasil disimpan pada '+dt+'.')}catch(e){toast('Absensi gagal disimpan: '+e.message)}};
async function renderReport(){if(!state.db){$('reportRows').innerHTML='<tr><td colspan="7" class="empty">Hubungkan database terlebih dahulu.</td></tr>';return}const from=$('reportFrom').value||today(),to=$('reportTo').value||today();const {data,error}=await state.db.from('attendance').select('*').gte('work_date',from).lte('work_date',to).order('work_date',{ascending:false});if(error){$('reportRows').innerHTML=`<tr><td colspan="7" class="empty">${esc(error.message)}</td></tr>`;return}let rows=(data||[]).map(a=>({...a,person:state.staff.find(p=>p.id===a.employee_id)||{}}));const type=$('reportType').value,search=$('reportSearch').value.toLowerCase();rows=rows.filter(a=>(!type||a.person.employee_type===type)&&(!search||String(a.employee_id).toLowerCase().includes(search)||String(a.person.name||'').toLowerCase().includes(search)));state.report=rows;$('reportRows').innerHTML=rows.length?rows.map(a=>`<tr><td>${esc(a.work_date)}</td><td>${esc(a.employee_id)}</td><td>${esc(a.person.name||'-')}</td><td>${esc(a.person.employee_type||'-')}</td><td>${esc(a.check_in||'-')}</td><td>${esc(a.check_out||'-')}</td><td><span class="status ${a.status==='Terlambat'?'late':''}">${esc(a.status||'Hadir')}</span></td></tr>`).join(''):'<tr><td colspan="7" class="empty">Tidak ada data untuk filter ini.</td></tr>'}
$('loadReport').onclick=renderReport;
$('exportCsv').onclick=()=>{const rows=state.report||[];if(!rows.length)return toast('Tidak ada data laporan untuk diekspor.');const csv=[['Tanggal','ID Pegawai','Nama','Jenis Pegawai','Jam Masuk','Jam Pulang','Status','Catatan'],...rows.map(a=>[a.work_date,a.employee_id,a.person.name||'',a.person.employee_type||'',a.check_in||'',a.check_out||'',a.status||'',a.note||''])].map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='laporan-absensi-sma3-sarmi.csv';a.click();URL.revokeObjectURL(url)};
(async()=>{const s=getSettings();showAuth('Masukkan konfigurasi Supabase atau tunggu konfigurasi yang tersimpan dimuat.');if(s.url&&s.key){$('supabaseUrl').value=s.url;$('supabaseKey').value=s.key;$('authSupabaseUrl').value=s.url;$('authSupabaseKey').value=s.key;$('lateTime').value=s.late||'07:30';try{await connect(s.url,s.key)}catch(e){setConn('Koneksi gagal');showAuth('Tidak dapat memuat database: '+e.message);}}})();
</script></body></html>
