isplay:none}.footer{font-size:11px;color:#8090a0;margin-top:25px}@media(max-width:900px){.app{grid-template-columns:1fr}.sidebar{padding:12px 15px}.brand{padding:4px 7px 12px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap}.side-note{display:none}.topbar{padding:0 18px}.content{padding:22px 16px}.stats{grid-template-columns:repeat(2,1fr)}.layout{grid-template-columns:1fr}}@media(max-width:480px){.heading{display:block}.pill{display:inline-block;margin-top:13px}.formgrid{grid-template-columns:1fr}.full{grid-column:auto}.stats{gap:9px}.stat{padding:14px}.stat strong{font-size:23px}}

.auth-gate{position:fixed;inset:0;z-index:100;background:#0d2036cc;display:none;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(5px)}.auth-card{width:min(100%,520px);max-height:92vh;overflow:auto;background:white;border-radius:18px;padding:25px;box-shadow:0 24px 80px #0004}.auth-card h1{font-size:22px;margin:0 0 8px}.auth-card p{font-size:13px;line-height:1.6;color:#66778a}.auth-card .field{margin-bottom:12px}.auth-status{font-size:12px;line-height:1.6;padding:10px 12px;border-radius:9px;background:#eef5fb;color:#24425e;margin:12px 0}.top-actions{display:flex;align-items:center;gap:10px}@media(max-width:480px){.auth-card{padding:19px}}
